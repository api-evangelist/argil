{
  "opencollection": "1.0.0",
  "info": {
    "name": "Argil Assets Avatars API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Avatars",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List avatars",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.argil.ai/v1/avatars"
          },
          "docs": "Returns all avatars available to the account, including stock avatars."
        },
        {
          "info": {
            "name": "Create an avatar",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.argil.ai/v1/avatars",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new avatar from training media. See also the video-based avatar creation flow."
        },
        {
          "info": {
            "name": "Get an avatar",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.argil.ai/v1/avatars/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieves a single avatar by its ID."
        }
      ]
    }
  ],
  "bundled": true
}