{
  "opencollection": "1.0.0",
  "info": {
    "name": "Argil Assets API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Assets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List assets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.argil.ai/v1/assets"
          },
          "docs": "Returns all assets in the account's library."
        },
        {
          "info": {
            "name": "Upload an asset",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.argil.ai/v1/assets",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new asset from a URL for use as B-roll or background music."
        },
        {
          "info": {
            "name": "Get an asset",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.argil.ai/v1/assets/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieves an asset and its processing status by ID."
        },
        {
          "info": {
            "name": "Delete an asset",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.argil.ai/v1/assets/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Removes an uploaded asset by ID."
        }
      ]
    }
  ],
  "bundled": true
}